    },
    "In-app mount goes to /Volumes (macOS 27+). Choose a folder to mount into a custom location via a Terminal command." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用内挂载会挂到 /Volumes(需 macOS 27+)。若要挂载到自定义位置,请选择一个文件夹,通过终端命令完成。"
          }
        }
      }
    },
    "Install path unknown." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装路径未知。"
          }
        }
      }
    },
    "Linux drives (ext, XFS, Btrfs) mount automatically under /Volumes via the file-system extension. Use this app to eject, remount read-only, mount to a folder you choose, or open a disk image." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ext、XFS、Btrfs 磁盘会通过文件系统扩展自动挂载到 /Volumes。本应用可用于推出、以只读方式重新挂载、挂载到你选择的文件夹,或打开磁盘映像。"
          }
        }
      }
    },
    "Linux file-system extension not enabled" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux 文件系统扩展未启用"
          }
        }
      }
    },
    "Linux file-system extension not installed" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux 文件系统扩展未安装"
          }
        }
      }
    },
    "lklfuse is enabled and available to mount Linux volumes (ext, XFS, Btrfs)." : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lklfuse 已启用,可用于挂载 Linux 卷(ext、XFS、Btrfs)。"
          }
        }
      }
    },
    "lklfuse is enabled in System Settings." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lklfuse 已在系统设置中启用。"
          }
        }
      }
    },
    "lklfuse is included in this app. macOS 15 cannot reliably report third-party FSKit registration or enablement to the app." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用内已包含 lklfuse。macOS 15 无法向应用可靠地报告第三方 FSKit 扩展的注册和启用状态。"
          }
        }
      }
    },
    "lklfuse is registered with the system." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
